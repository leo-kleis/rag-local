# ============================================================
# Variables de entorno para rag-local
# Copia este archivo a .env y ajusta los valores
# ============================================================

# Directorio raíz que contiene tus proyectos de código fuente.
# Dentro del contenedor se monta en /workspaces/
# Ejemplo Windows: WORKSPACE_DIR=C:\Users\Leo\Repo
WORKSPACE_DIR=..

# API key de Gemini para el modelo de generación de respuestas.
# Obtén la tuya en https://aistudio.google.com/
GEMINI_API_KEY=

# Transporte del servidor MCP.
# stdio: para uso con clientes MCP (Antigravity, Claude Desktop, etc.)
# http | sse: para uso como servidor HTTP standalone
MCP_TRANSPORT=stdio

# Puerto del servidor FastMCP en modo HTTP/SSE (solo si MCP_TRANSPORT=http o sse)
MCP_PORT=8000
